# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/playwright:v1.62.1-noble

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg unzip ca-certificates fonts-liberation fonts-noto-color-emoji \
    espeak-ng python3 python3-pip \
  && pip3 install --no-cache-dir --break-system-packages edge-tts \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
COPY infra ./infra
COPY kane ./kane

RUN npm ci && npx playwright install --with-deps chromium \
  && npm i -g @testmuai/kane-cli@0.8.4 @testmuai/kane-cli-linux-x64@0.8.4 \
  && find "$(npm root -g)/@testmuai" -type f \( \
       -name 'kane-cli' -o -name 'v16-runner' -o -name 'assurance-agent' -o -name 'node' \
     \) -exec chmod 755 {} \;

ENV KANE_HEADLESS=1
ENV KANE_CLI_SYSTEM_NODE=1
ENV NODE_ENV=production

COPY infra/docker-entrypoint-worker.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["npm", "run", "start", "-w", "@demo-studio/worker"]
