# Local Postgres (same user as FounderBlaze; we use database demostudio)
DATABASE_URL=postgres://founderforge:founderforge@localhost:5432/demostudio

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

API_PORT=4031
PUBLIC_API_BASE_URL=http://localhost:4031
SAMPLE_APP_URL=http://localhost:4173

# Supabase Storage (from FounderBlaze). Create a private bucket named demo-studio if it does not exist.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=demo-studio

LMNT_API_KEY=
LMNT_VOICE=lily

KANE_WS_ENDPOINT=
KANE_USERNAME=
KANE_ACCESS_KEY=
KANE_PROJECT_ID=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash
# Headless Kane + Playwright Chromium (set KANE_HEADED=1 to watch locally)
KANE_HEADLESS=1
# macOS ffmpeg screen index is unused; Kane stills + CDP recording are used instead
KANE_FFMPEG_INPUT=
WORKER_IDENTITY=local-1
