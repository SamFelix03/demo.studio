# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
RUN npm ci && npm run build -w @demo-studio/studio

FROM nginx:1.27-alpine
COPY infra/nginx-studio-entrypoint.sh /nginx-studio-entrypoint.sh
RUN chmod +x /nginx-studio-entrypoint.sh
ENV PORT=80
ENV API_UPSTREAM=http://127.0.0.1:4031
COPY --from=build /app/apps/studio/dist /usr/share/nginx/html
EXPOSE 80
CMD ["/nginx-studio-entrypoint.sh"]
