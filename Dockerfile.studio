# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/studio ./apps/studio
COPY packages ./packages
RUN npm ci && npm run build -w @demo-studio/studio

FROM nginx:1.27-alpine
COPY infra/nginx-studio.conf /etc/nginx/templates/default.conf.template
ENV API_UPSTREAM=http://api:4031
COPY --from=build /app/apps/studio/dist /usr/share/nginx/html
EXPOSE 80
