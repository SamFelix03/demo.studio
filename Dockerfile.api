# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
COPY infra ./infra
COPY kane ./kane
COPY docs ./docs
COPY .studio-verify ./.studio-verify
RUN npm ci
ENV NODE_ENV=production
EXPOSE 4031
CMD ["sh", "-c", "npm run migrate && npm run start -w @demo-studio/api"]
